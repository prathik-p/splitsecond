{
  "name": "splitsecond",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @splitsecond/shared build && pnpm -r --parallel dev",
    "build": "pnpm --filter @splitsecond/shared build && pnpm --filter \"./apps/*\" build",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter @splitsecond/api prisma:migrate",
    "db:seed": "pnpm --filter @splitsecond/api seed"
  }
}
