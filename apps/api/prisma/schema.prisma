generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A song: in the playable pool, or kept out of it because a played run points at it.
model Track {
  id         String   @id @default(cuid())
  /// Apple's id for the recording; the audio is its 30-second preview.
  itunesId   BigInt?  @unique
  /// Last known preview URL (iTunes). Refreshed by a lookup if it stops working.
  previewUrl String?
  title      String
  artist     String
  album      String?
  coverUrl   String?
  /// Popularity, higher is easier: derived from a chart position or Apple's listing order.
  rank       Int
  /// The year the song was a hit, when it came from a by-year seed.
  year       Int?
  /// The catalog's genre for the song ("Pop", "Hip-Hop/Rap"), where it gives one.
  genre      String?
  /// Normalised "title::artist", used to treat re-releases as the same song.
  songKey    String
  inPool     Boolean  @default(true)
  /// In the pool only because its artist's whole catalogue was added (artists.txt),
  /// not because it was a hit. These come up only when that artist is picked.
  catalogOnly Boolean @default(false)
  createdAt  DateTime @default(now())

  rounds   Round[]
  guesses  Guess[]
  sources  TrackSource[]

  @@index([inPool, rank])
  @@index([songKey])
}

/// Why a track is in the pool: a chart entry, Apple's current chart, or an artist catalogue.
model TrackSource {
  id        String   @id @default(cuid())
  trackId   String
  kind      String   // "billboard" | "apple-chart" | "artist"
  reference String   // "2016:3" (year:position), "most-played", or Apple's artist id
  createdAt DateTime @default(now())

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([trackId, kind, reference])
}

/// An artist from artists.txt whose whole catalogue is added to the pool.
model ArtistImport {
  /// Apple's id for the artist.
  itunesId   BigInt   @id
  name       String
  /// The line in artists.txt this came from, lower-cased, so the seed doesn't look it up again.
  query      String
  /// Albums already read, so a stopped seed continues and a later one only reads new releases.
  albumsDone String[] @default([])
  /// Which version of the "what counts as a song" rules the albums were read with.
  /// When the rules change, the artist is read again from scratch.
  rules      Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([query])
}

model Run {
  id         String    @id @default(cuid())
  totalScore Int       @default(0)
  createdAt  DateTime  @default(now())
  finishedAt DateTime?
  /// Run options: the genres and artists the songs were limited to. Empty means any.
  genres     String[]  @default([])
  artists    String[]  @default([])

  rounds Round[]
}

enum RoundStatus {
  PLAYING
  SOLVED
  GIVEN_UP
}

/// The round id is what the browser sees. It never learns the track's id
/// until the round is over.
model Round {
  id              String      @id @default(cuid())
  runId           String
  index           Int
  trackId         String
  unlockedSeconds Float       @default(0.1)
  wrongGuesses    Int         @default(0)
  status          RoundStatus @default(PLAYING)
  score           Int?
  createdAt       DateTime    @default(now())
  endedAt         DateTime?

  run     Run     @relation(fields: [runId], references: [id], onDelete: Cascade)
  track   Track   @relation(fields: [trackId], references: [id])
  guesses Guess[]

  @@unique([runId, index])
}

model Guess {
  id              String   @id @default(cuid())
  roundId         String
  guessedTrackId  String
  correct         Boolean
  unlockedSeconds Float
  createdAt       DateTime @default(now())

  round        Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
  guessedTrack Track @relation(fields: [guessedTrackId], references: [id])
}
