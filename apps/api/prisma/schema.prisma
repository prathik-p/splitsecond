generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A song in the playable pool. Later steps (Last.fm import, profiles) attach
/// sources to tracks through TrackSource without changing this table.
model Track {
  id         String   @id @default(cuid())
  deezerId   BigInt   @unique
  isrc       String?  @unique
  title      String
  artist     String
  album      String?
  coverUrl   String?
  /// Deezer popularity rank. Higher is more popular, so easier.
  rank       Int
  /// Normalised "title::artist", used to treat re-releases as the same song.
  songKey    String
  inPool     Boolean  @default(true)
  createdAt  DateTime @default(now())

  rounds   Round[]
  guesses  Guess[]
  sources  TrackSource[]
  profiles ProfileTrack[]

  @@index([inPool, rank])
  @@index([songKey])
}

/// Where a track came from: the fixed seed pool now, user profiles later.
model TrackSource {
  id        String   @id @default(cuid())
  trackId   String
  kind      String   // "seed" | "lastfm" | "deezer_playlist" | ...
  reference String   // playlist id, username, ...
  createdAt DateTime @default(now())

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([trackId, kind, reference])
}

model Run {
  id         String    @id @default(cuid())
  nickname   String?
  totalScore Int       @default(0)
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  rounds   Round[]
  /// Profiles whose songs this run draws from. Empty means the default pool.
  profiles Profile[] @relation("RunProfiles")

  @@index([finishedAt, totalScore])
}

enum RoundStatus {
  PLAYING
  SOLVED
  GIVEN_UP
}

/// The round id is what the browser sees. It never learns the Deezer id
/// until the round is over.
model Round {
  id              String      @id @default(cuid())
  runId           String
  index           Int
  trackId         String
  unlockedSeconds Float       @default(0.1)
  wrongGuesses    Int         @default(0)
  status          RoundStatus @default(PLAYING)
  score           Int?
  createdAt       DateTime    @default(now())
  endedAt         DateTime?

  run     Run     @relation(fields: [runId], references: [id], onDelete: Cascade)
  track   Track   @relation(fields: [trackId], references: [id])
  guesses Guess[]

  @@unique([runId, index])
}

model Guess {
  id              String   @id @default(cuid())
  roundId         String
  guessedTrackId  String
  correct         Boolean
  unlockedSeconds Float
  createdAt       DateTime @default(now())

  round        Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
  guessedTrack Track @relation(fields: [guessedTrackId], references: [id])
}

enum ImportStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

/// A listener whose music can be played, e.g. a Last.fm username.
model Profile {
  id          String       @id @default(cuid())
  source      String       // "lastfm" today
  /// Lower-cased, so "RJ" and "rj" are the same profile.
  username    String
  displayName String
  status      ImportStatus @default(PENDING)
  /// Import progress: songs found on the source, looked at so far, and matched to Deezer.
  total       Int          @default(0)
  processed   Int          @default(0)
  matched     Int          @default(0)
  error       String?
  importedAt  DateTime?
  createdAt   DateTime     @default(now())

  tracks ProfileTrack[]
  runs   Run[]          @relation("RunProfiles")

  @@unique([source, username])
}

/// A song a profile listens to. One Track can belong to many profiles.
model ProfileTrack {
  profileId String
  trackId   String
  playcount Int     @default(0)
  loved     Boolean @default(false)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  track   Track   @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([profileId, trackId])
  @@index([trackId])
}
