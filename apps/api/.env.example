DATABASE_URL="postgresql://splitsecond:splitsecond@localhost:5432/splitsecond?schema=public"
PORT=4000
# Where the web app runs, for CORS. The web app proxies /api, so this only matters if you call the API directly.
WEB_ORIGIN=http://localhost:3000
# Where songs and previews come from: "itunes" (Apple, works everywhere, the default)
# or "deezer" (not available in every country; India is one it doesn't serve).
MUSIC_PROVIDER=itunes
# iTunes storefront to search, and how many calls a minute to allow (Apple asks for about 20).
ITUNES_COUNTRY=US
ITUNES_PER_MINUTE=19
# Seed: the hits of each year in this range, this far down each year's chart (0 skips them).
HITS_FROM=2000
HITS_TO=
HITS_PER_YEAR=50
# Seed, optional: Wikipedia limits clients less when they name a contact.
# WIKIPEDIA_USER_AGENT="my-app/1.0 (me@example.com)"
# Seed, Deezer only: extra playlist IDs to add as they are, comma-separated.
SEED_PLAYLISTS=

# Last.fm import. Create a free key at https://www.last.fm/api/account/create
LASTFM_API_KEY=
# How many of a profile's top tracks to import (loved tracks are added on top).
LASTFM_TOP_LIMIT=200

# The services can be pointed elsewhere for offline work; see test/mock-services.ts.
# ITUNES_API_BASE=  WIKIPEDIA_API_BASE=  APPLE_CHART_URL=  DEEZER_API_BASE=  LASTFM_API_BASE=
