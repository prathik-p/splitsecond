DATABASE_URL="postgresql://splitsecond:splitsecond@localhost:5432/splitsecond?schema=public"
PORT=4000
# Where the web app runs, for CORS. The web app proxies /api, so this only matters if you call the API directly.
WEB_ORIGIN=http://localhost:3000
# Override only for tests (points the API at a mock Deezer).
DEEZER_API_BASE=https://api.deezer.com
# Seed: the hits of each year in this range, this many per year (0 skips them).
HITS_FROM=2000
HITS_TO=
HITS_PER_YEAR=60
# Seed: extra Deezer playlist IDs to add as they are, comma-separated.
SEED_PLAYLISTS=

# Last.fm import. Create a free key at https://www.last.fm/api/account/create
LASTFM_API_KEY=
# How many of a profile's top tracks to import (loved tracks are added on top).
LASTFM_TOP_LIMIT=200
# Override only for tests (points the API at a mock Last.fm).
LASTFM_API_BASE=https://ws.audioscrobbler.com/2.0/
